<Project Sdk="Microsoft.NET.Sdk">
  <!-- The UI-framework-free part of the editor: models, playback, audio routing, plug-in catalogue and rules, presets and
       services that do not touch a UI framework. The app (src/TabForge.Avalonia) references it; it never references the app.
       Builds for net10.0 (portable hosts) and net10.0-windows (the app and the engine). The Windows-only files below
       (COM, Media Foundation, DXGI, Windows identity, Win32 timing) compile only into net10.0-windows. -->
  <PropertyGroup>
    <!-- Windows builds only net10.0-windows: the engine client, playback engine and MIDI adapters exist only there. Other hosts
         build net10.0 alone; -p:TabForgePortableBuild=true builds net10.0 on Windows too (the CI portability check). The
         net10.0 build has its own lock file, so the Windows lock file and the shipped build stay as they are. -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(TabForgePortableBuild)' != 'true'">net10.0-windows</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('Windows')) Or '$(TabForgePortableBuild)' == 'true'">net10.0</TargetFrameworks>
    <NuGetLockFilePath Condition="'$(TargetFrameworks)' == 'net10.0'">packages.portable.lock.json</NuGetLockFilePath>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>TabForge.Core</AssemblyName>
    <RootNamespace>TabForge</RootNamespace>
    <!-- Nullable, warnings-as-errors, analysis, locked restore and Version: see Directory.Build.props. -->
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='net10.0'">
    <Compile Remove="Services\Video\VideoEncoder.cs;Services\Video\VideoEncoder.Writer.cs;Services\Video\VideoEncoder.Finalize.cs;Platform\Windows\*.cs" />
    <Compile Remove="Services\Video\DxgiRegionGrabber.cs;Services\Video\DesktopRegionGrabber.cs" />
    <Compile Remove="Audio\WindowsMidiLatency.cs;Audio\WindowsPathOffset.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Platform\Theme\Looks\*.json" />
    <EmbeddedResource Include="Platform\Theme\Palette\*.json" />
    <!-- Same packages and wire contracts as the app and the audio engine (see their csproj files). -->
    <PackageReference Include="TabForge.AlphaTab" Version="1.8.4-tabforge.4" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <ProjectReference Include="..\TabForge.Audio.Contracts\TabForge.Audio.Contracts.csproj" />
    <!-- The app uses the Core's internal helpers (same owner, same build). -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>TabForge</_Parameter1>
    </AssemblyAttribute>
    <!-- The Avalonia geometry proof drives the Core score host (ScoreGeometryProbe). -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>TabForge.Avalonia.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- The TabForge app shows the demo score through the same Core score host. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>TabForge.Avalonia</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
