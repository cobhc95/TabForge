<Window x:Class="TabForge.Views.TutorialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:TabForge.Views"
        Title="TabForge Beginner's Guide" Width="1040" Height="720" MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        AutomationProperties.Name="TabForge Beginner's Guide">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="Padding" Value="9,3"/>
        </Style>
        <!-- Contents row: chapters in bold, headings of the open chapter indented below it. -->
        <DataTemplate x:Key="NavTemplate" DataType="{x:Type v:TutorialNavItem}">
            <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" Margin="{Binding Indent}"
                       FontWeight="{Binding Weight}" FontSize="{Binding FontSize}"
                       ToolTip="{Binding Text}" AutomationProperties.Name="{Binding Automation}"/>
        </DataTemplate>
        <!-- Search hit: where it is, then the text around the match with the match in bold. -->
        <DataTemplate x:Key="ResultTemplate" DataType="{x:Type v:TutorialResultItem}">
            <StackPanel Margin="2,3" AutomationProperties.Name="{Binding Automation}">
                <TextBlock Text="{Binding Where}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock v:TutorialSnippet.Result="{Binding Result}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar: history, chapter steps, search, export. -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Which guide: Basic or Detailed (switching reloads contents, search and reader). -->
                <StackPanel x:Name="GuideSwitch" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6"
                            AutomationProperties.Name="Guide">
                    <RadioButton x:Name="BasicGuideRadio" GroupName="Guide" Content="Basic guide" Margin="2,0,16,0" IsChecked="True"
                                 AutomationProperties.Name="Basic guide" ToolTip="The short guide for getting started" Checked="Guide_Checked"/>
                    <RadioButton x:Name="DetailedGuideRadio" GroupName="Guide" Content="Detailed guide"
                                 AutomationProperties.Name="Detailed guide" ToolTip="The full reference to every feature" Checked="Guide_Checked"/>
                </StackPanel>
                <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="160"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BackButton" Style="{StaticResource NavButton}" Content="&#x25C0; Back" ToolTip="Back" AutomationProperties.Name="Back" Click="Back_Click"/>
                    <Button x:Name="ForwardButton" Style="{StaticResource NavButton}" Content="Forward &#x25B6;" ToolTip="Forward" AutomationProperties.Name="Forward" Click="Forward_Click"/>
                    <Button x:Name="PrevButton" Style="{StaticResource NavButton}" Content="&#x2039; Previous chapter" ToolTip="Previous chapter" AutomationProperties.Name="Previous chapter" Click="Prev_Click" Margin="10,1,1,1"/>
                    <Button x:Name="NextButton" Style="{StaticResource NavButton}" Content="Next chapter &#x203A;" ToolTip="Next chapter" AutomationProperties.Name="Next chapter" Click="Next_Click"/>
                </StackPanel>
                <Grid Grid.Column="1" Margin="12,1,8,1">
                    <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" MinHeight="26" Padding="6,2,26,2"
                             ToolTip="Search the whole guide (Ctrl+F). Esc clears the search."
                             AutomationProperties.Name="Search the guide" TextChanged="Search_TextChanged"/>
                    <TextBlock x:Name="SearchHint" Text="Search the guide (Ctrl+F)" IsHitTestVisible="False" Margin="9,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <Button x:Name="ClearSearchButton" Content="&#x2715;" HorizontalAlignment="Right" Width="22" MinHeight="20" Padding="0" Margin="0,0,3,0" Visibility="Collapsed"
                            ToolTip="Clear the search (Esc)" AutomationProperties.Name="Clear the search" Click="ClearSearch_Click"/>
                </Grid>
                <Button x:Name="ExportButton" Grid.Column="2" Content="Export PDF&#x2026;" ToolTip="Save the whole guide as a PDF" AutomationProperties.Name="Export the guide as a PDF"
                        Padding="12,3" Click="Export_Click"/>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" x:Name="Body">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" MinWidth="170"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Left: contents, or the search hits while something is typed. -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}">
                <Grid>
                    <ListBox x:Name="ContentsList" Background="Transparent" BorderThickness="0" Padding="4" ItemTemplate="{StaticResource NavTemplate}"
                             AutomationProperties.Name="Contents" SelectionChanged="Contents_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"/>
                    <ListBox x:Name="ResultsList" Background="Transparent" BorderThickness="0" Padding="4" Visibility="Collapsed" ItemTemplate="{StaticResource ResultTemplate}"
                             AutomationProperties.Name="Search results" SelectionChanged="Results_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"/>
                    <TextBlock x:Name="NoResults" Text="Nothing matches that search." Margin="14,16" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{DynamicResource MutedBrush}"/>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderSoftBrush}" ResizeBehavior="PreviousAndNext"
                          AutomationProperties.Name="Resize the contents panel"/>

            <!-- Right: the chapter. -->
            <Grid Grid.Column="2">
                <FlowDocumentScrollViewer x:Name="Reader" Background="{DynamicResource WindowBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          IsToolBarVisible="False" Zoom="100" SizeChanged="Reader_SizeChanged"
                                          AutomationProperties.Name="Chapter text" Focusable="True"/>
                <StackPanel x:Name="EmptyMessage" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Margin="24">
                    <TextBlock Text="The guide isn't here yet" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <TextBlock Text="TabForge could not find the Beginner's Guide chapters next to the program. Reinstalling or updating TabForge puts them back; the rest of the app is not affected."
                               TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Export progress and result. -->
        <Border x:Name="StatusBar" Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="10,5" Visibility="Collapsed">
            <DockPanel LastChildFill="True">
                <Button x:Name="CancelExportButton" DockPanel.Dock="Right" Content="Cancel" Visibility="Collapsed" Click="CancelExport_Click" AutomationProperties.Name="Cancel the PDF export"/>
                <Button x:Name="DismissStatusButton" DockPanel.Dock="Right" Content="&#x2715;" Width="26" Visibility="Collapsed" Click="DismissStatus_Click" ToolTip="Hide this message" AutomationProperties.Name="Hide this message"/>
                <ProgressBar x:Name="ExportProgress" DockPanel.Dock="Right" Width="160" Height="10" Margin="10,0" Visibility="Collapsed" Style="{StaticResource ThemedProgressBar}"
                             AutomationProperties.Name="PDF export progress"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
