<UserControl x:Class="TabForge.Views.BrowserTabBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{x:Null}" Focusable="False">
    <!-- Rounded "pill" tabs that fade in on hover and brighten when active, a 20 px circular close
         button, a 36 px (+) button, and accent overflow arrows that appear only when the strip is wider
         than its viewport. -->
    <UserControl.Resources>
        <Style x:Key="TabOverflowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.72"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabPlusButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource TabHoverBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabCloseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource TabCloseHoverBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="Transparent" AllowDrop="True"
          WindowChrome.IsHitTestVisibleInChrome="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- overflow arrows: shown only while the strip is wider than its viewport -->
        <Button x:Name="OverflowLeftButton" Grid.Column="0" Style="{StaticResource TabOverflowButton}"
                Visibility="Collapsed" Click="OverflowLeft_Click" ToolTip="Show tabs to the left"
                AutomationProperties.Name="Scroll tabs left"
                WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPrevious}" Stroke="#FFFFFF" Width="13" Height="13"/>
        </Button>

        <ScrollViewer x:Name="Scroll" Grid.Column="1" Background="{x:Null}" Padding="0"
                      VerticalAlignment="Top" Height="36"
                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                      Focusable="False">
            <!-- Tabs start flush at the left edge (with a small inset) so the first tab is a
                 muscle-memory target when maximised. -->
            <StackPanel Orientation="Horizontal" Background="{x:Null}" Margin="8,0,0,0"
                        VerticalAlignment="Top">
                <ItemsControl x:Name="TabStrip" Background="{x:Null}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="TabRoot" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                    Focusable="True" KeyboardNavigation.IsTabStop="True"
                                    CornerRadius="{Binding TabCornerRadius}"
                                     Height="36" VerticalAlignment="Top" MinWidth="0" Padding="0" Margin="0,0,3,0" Cursor="Arrow"
                                    WindowChrome.IsHitTestVisibleInChrome="True" AllowDrop="True">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="_New tab" Click="MenuNewTab_Click"/>
                                        <MenuItem Header="D_uplicate" Click="MenuDuplicate_Click"/>
                                        <Separator/>
                                        <MenuItem Header="_Close tab" Click="MenuClose_Click"/>
                                        <MenuItem Header="Close _others" Click="MenuCloseOthers_Click"/>
                                        <MenuItem Header="Close tabs to the _right" Click="MenuCloseRight_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Move to _new window" Click="MenuDetach_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid Margin="8,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- playing badge: shown only for the tab whose score is playing -->
                                    <Path x:Name="PlayingBadge" Grid.Column="0" Margin="0,0,5,0"
                                          VerticalAlignment="Center" Width="8" Height="9" Stretch="Uniform"
                                          Fill="{DynamicResource PlayBrush}" Visibility="{Binding PlayingVisibility}"
                                          Data="M0,3 L3,3 L6,0 L6,9 L3,6 L0,6 Z"
                                          ToolTip="This tab is playing"/>

                                    <TextBlock x:Name="TabTitle" Grid.Column="1" Text="{Binding Title}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedBrush}"/>

                                    <Ellipse x:Name="DirtyDot" Grid.Column="2" Width="7" Height="7" Fill="{DynamicResource CursorBrush}"
                                             VerticalAlignment="Center" Margin="7,0,0,0"
                                             Visibility="{Binding DirtyVisibility}"
                                             ToolTip="Unsaved changes"/>

                                    <Button x:Name="TabClose" Grid.Column="3"
                                            Click="TabClose_Click" AutomationProperties.Name="Close tab">
                                        <Path Data="{StaticResource IconClose}" Stroke="#B4BEC8" StrokeThickness="1.4"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="10" Height="10" Stretch="Uniform" Fill="Transparent"/>
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource TabCloseButton}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding ShowCloseOnHover}" Value="True"/>
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                    <DataTrigger Binding="{Binding CloseAlways}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CloseNever}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <!-- hover first, active second: the active tab keeps its brighter pill while hovered -->
                                <Trigger SourceName="TabRoot" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabRoot" Property="Background" Value="{DynamicResource TabHoverBrush}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="TabRoot" Property="Background" Value="{DynamicResource TabActiveBrush}"/>
                                    <Setter TargetName="TabTitle" Property="Foreground" Value="{DynamicResource TextStrongBrush}"/>
                                </DataTrigger>
                                <Trigger SourceName="TabRoot" Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="TabRoot" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- (+) sits immediately after the last tab -->
                <Button x:Name="NewTabButton" Style="{StaticResource TabPlusButton}"
                        ToolTip="New score in a new tab (Ctrl+T)" Click="NewTab_Click"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="New tab"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPlus}" Stroke="{DynamicResource TabIdleGlyphBrush}"/>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <Button x:Name="OverflowRightButton" Grid.Column="2" Style="{StaticResource TabOverflowButton}"
                Visibility="Collapsed" Click="OverflowRight_Click" ToolTip="Show tabs to the right"
                AutomationProperties.Name="Scroll tabs right"
                WindowChrome.IsHitTestVisibleInChrome="True">
            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconNext}" Stroke="#FFFFFF" Width="13" Height="13"/>
        </Button>

        <!-- insertion marker while dragging a tab -->
        <Rectangle x:Name="DropMarker" Grid.Column="1" Width="2" HorizontalAlignment="Left"
                    Fill="{DynamicResource AccentBrush}" RadiusX="1" RadiusY="1" Margin="0,0"
                   Visibility="Collapsed" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
