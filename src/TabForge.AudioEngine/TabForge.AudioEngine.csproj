<Project Sdk="Microsoft.NET.Sdk">
  <!-- Audio engine: runs ONLY inside the separate engine process (TabForge.exe, audio-engine mode). It is the
       only code that opens audio devices or loads plug-in code; the editor never calls it directly. -->
  <PropertyGroup>
    <!-- Windows builds net10.0-windows only (the shipped engine). -p:TabForgePortableBuild=true (and every non-Windows host) builds net10.0 with the
         portable audio/MIDI backends; the Windows device, plug-in and editor files are left out below. Own lock file, so the shipped one is untouched. -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(TabForgePortableBuild)' != 'true'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows')) Or '$(TabForgePortableBuild)' == 'true'">net10.0</TargetFramework>
    <NuGetLockFilePath Condition="'$(TargetFramework)' == 'net10.0'">packages.portable.lock.json</NuGetLockFilePath>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <!-- Self-test hooks (the hang command, the managed test effect) are compiled only into Debug and full-suite builds, never into Release. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' Or '$(TabForgeFullSuite)' == 'true'">
    <DefineConstants>$(DefineConstants);TABFORGE_TEST_HOOKS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TabForge.Audio.Contracts\TabForge.Audio.Contracts.csproj" />
    <InternalsVisibleTo Include="TabForge.Avalonia.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- VST3 host shim (native\tfvst3, built from the Steinberg VST3 SDK); optional until it is built. -->
    <None Include="native\tfvst3.dll" Condition="Exists('native\tfvst3.dll')" Link="tfvst3.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MeltySynth" Version="2.4.1" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="SoundTouch.Net" Version="2.3.2" />
  </ItemGroup>
</Project>
