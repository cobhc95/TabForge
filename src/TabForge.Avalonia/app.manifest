<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" processorArchitecture="*" name="TabForge.app" type="win32" />
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <!-- Windows refuses a layered child window unless the exe declares Windows 8 or later here; without it CreateWindowEx fails
       with ERROR_INVALID_PARAMETER, and Avalonia's NativeControlHost (the docked plug-in editor) cannot create its holder. -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}" />
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings xmlns:ws="http://schemas.microsoft.com/SMI/2016/WindowsSettings">
      <ws:longPathAware>true</ws:longPathAware>
      <!-- Per-monitor V2: crisp scaling on every monitor and live re-layout when the scale changes. Set on the exe, so the
           audio engine and the plug-in host processes (the same exe, started with the audio-engine or plug-in-host switch) inherit it;
           a DPI-unaware plug-in editor window is bitmap-scaled by Windows. -->
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
