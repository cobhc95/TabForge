<?xml version="1.0" encoding="utf-8"?>
<!-- Non-shipping publish profile for linux-x64 (cross-platform Stage 5): dotnet publish -p:PublishProfile=linux-x64. Windows keeps tools/Publish.ps1.
     The portable target has no locked restore (the lock files are for the Windows build), so run it from a scratch copy, as tools/package-*.sh do.
     On a Windows host also pass -p:TabForgePortableBuild=true (the target framework is chosen before a profile is read; macOS and Linux hosts pick net10.0 on their own). -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TabForgePortableBuild>true</TabForgePortableBuild>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RestoreLockedMode>false</RestoreLockedMode>
    <PublishDir>$(ArtifactsPath)publish/linux-x64/</PublishDir>
  </PropertyGroup>
</Project>
