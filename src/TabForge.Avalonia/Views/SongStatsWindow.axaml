<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TabForge.Avalonia.Views.SongStatsWindow"
        Width="400" Height="190" MinWidth="320" MinHeight="170"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}">
  <!-- Same controls and order as the WPF SongStatsWindow. Texts are set in the code-behind. -->
  <DockPanel Margin="14">
    <Button x:Name="CloseButton" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,10,0,0" Padding="12,4"
            IsCancel="True" Foreground="{DynamicResource TextPrimary}" />
    <StackPanel>
      <TextBlock x:Name="HeadingText" TextWrapping="Wrap" FontWeight="SemiBold" />
      <TextBlock x:Name="CountsText" TextWrapping="Wrap" Margin="0,10,0,0" />
    </StackPanel>
  </DockPanel>
</Window>
