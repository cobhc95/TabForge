<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TabForge.Avalonia.Views.ChordFinderWindow"
        Title="Chord finder" Width="380" Height="330" MinWidth="320" MinHeight="260"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}">
  <!-- Same controls, order and texts as the WPF ChordFinderWindow. -->
  <DockPanel Margin="14">
    <WrapPanel DockPanel.Dock="Top">
      <TextBlock Text="Root" VerticalAlignment="Center" />
      <ComboBox x:Name="RootBox" Width="64" Margin="4,0,12,0" />
      <TextBlock Text="Type" VerticalAlignment="Center" />
      <ComboBox x:Name="TypeBox" Width="120" Margin="4,0,0,0" />
    </WrapPanel>
    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8,0,0"
               Foreground="{DynamicResource TextMuted}" />
    <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,10,0,0">
      <!-- Button text takes the palette text colour: the Core button look paints dark surfaces in both themes. -->
      <Button x:Name="ShowButton" Content="Show" Padding="12,4" Margin="0,0,8,0" Foreground="{DynamicResource TextPrimary}" />
      <Button x:Name="InsertButton" Content="Insert name" Padding="12,4" Margin="0,0,8,0" Foreground="{DynamicResource TextPrimary}" />
      <Button x:Name="CloseButton" Content="Close" Padding="12,4" IsCancel="True" Foreground="{DynamicResource TextPrimary}" />
    </WrapPanel>
    <ListBox x:Name="NotesList" Margin="0,10,0,0" MinHeight="90" />
  </DockPanel>
</Window>
