<Project Sdk="Microsoft.NET.Sdk">
  <!-- Standalone SoundFont 2 synthesizer with an optional modelled guitar/bass layer. No TabForge or third-party dependencies. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TabForge.Sf2Synth.Tests" />
    <EmbeddedResource Include="Guitar\Amps\captured.nam" LogicalName="TabForge.Sf2Synth.Guitar.Amps.captured.nam" />
  </ItemGroup>
</Project>
