<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Two sources only. TabForge.AlphaTab (alphaTab 1.8.4 plus four patches, built from source: vendor/alphatab/README.md) comes
       from the checked-in folder and nowhere else; every other package comes from nuget.org. The mapping also keeps a
       look-alike package on nuget.org from ever being picked for the patched id. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="tabforge-alphatab" value="vendor/alphatab" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="tabforge-alphatab">
      <package pattern="TabForge.AlphaTab" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
