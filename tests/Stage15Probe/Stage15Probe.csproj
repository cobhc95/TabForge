<Project Sdk="Microsoft.NET.Sdk">

  <!-- Stage 15 test-only probe: runs the same WineRuntime.EnsureReady in a separate process so the two-copy prefix
       test uses two real processes, not two threads. Never shipped and never referenced by the app or package. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TabForge.AudioEngine\TabForge.AudioEngine.csproj" />
  </ItemGroup>

</Project>
