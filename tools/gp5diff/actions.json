{
  "_doc": "Action vocabulary of the GP5 differential harness. Each action maps to GP5's default key chords or menu path and to TabForge's default keys or command id. keys: chords as 'ctrl+shift+left'; menu: [top menu index, downs] in GP5 (File 0, Edit 1, Bar 2, Track 3, Note 4, Effects 5); dialog: accept the dialog the action opens with its default button; cmd: a TabForge hotkey command id run as if its key were pressed; null: the app has no such action. fidelity: exact (same default key and meaning), equivalent (different default key, same command), approximate (closest command), missing.",
  "fret":         { "gp5": { "digits": true }, "tf": { "digits": true }, "fidelity": "exact", "note": "digits typed quickly. Each fret action is a separate typing after a pause: TabForge's 700 ms two-digit window is closed before it (the replay resets it); GP5 has no time limit, so a fret typed on the spot of the previous fret extends it in GP5" },
  "right":        { "gp5": { "keys": ["right"] }, "tf": { "keys": ["right"] }, "fidelity": "exact" },
  "left":         { "gp5": { "keys": ["left"] }, "tf": { "keys": ["left"] }, "fidelity": "exact" },
  "up":           { "gp5": { "keys": ["up"] }, "tf": { "keys": ["up"] }, "fidelity": "exact" },
  "down":         { "gp5": { "keys": ["down"] }, "tf": { "keys": ["down"] }, "fidelity": "exact" },
  "next_bar":     { "gp5": { "keys": ["ctrl+right"] }, "tf": { "keys": ["ctrl+right"] }, "fidelity": "exact" },
  "prev_bar":     { "gp5": { "keys": ["ctrl+left"] }, "tf": { "keys": ["ctrl+left"] }, "fidelity": "exact" },
  "home":         { "gp5": { "keys": ["home"] }, "tf": { "keys": ["home"] }, "fidelity": "exact" },
  "end":          { "gp5": { "keys": ["end"] }, "tf": { "keys": ["end"] }, "fidelity": "exact" },
  "first_bar":    { "gp5": { "keys": ["ctrl+home"] }, "tf": { "keys": ["ctrl+home"] }, "fidelity": "exact" },
  "last_bar":     { "gp5": { "keys": ["ctrl+end"] }, "tf": { "keys": ["ctrl+end"] }, "fidelity": "exact" },
  "delete_note":  { "gp5": { "keys": ["del"] }, "tf": { "keys": ["del"] }, "fidelity": "exact" },
  "delete_beat":  { "gp5": { "keys": ["ctrl+del"] }, "tf": { "cmd": "Edit.DeleteBeats" }, "fidelity": "equivalent", "note": "GP5 Ctrl+Del deletes the beat; TabForge binds Ctrl+Del to Delete bar and leaves Delete beats unbound" },
  "backspace":    { "gp5": { "keys": ["back"] }, "tf": { "keys": ["back"] }, "fidelity": "exact", "note": "not in GP5's shortcut list; the key is sent to both" },
  "insert_beat":  { "gp5": { "keys": ["ins"] }, "tf": { "keys": ["ins"] }, "fidelity": "exact" },
  "shorter":      { "gp5": { "keys": ["numadd"] }, "tf": { "keys": ["numadd"] }, "fidelity": "exact" },
  "longer":       { "gp5": { "keys": ["numsub"] }, "tf": { "keys": ["numsub"] }, "fidelity": "exact" },
  "dot":          { "gp5": { "keys": ["numdec"] }, "tf": { "keys": ["period"] }, "fidelity": "equivalent", "note": "GP5's main-row '.' does nothing; its numpad '.' and '*' dot" },
  "double_dot":   { "gp5": null, "tf": { "cmd": "Note.DoubleDot" }, "fidelity": "missing", "note": "GP5 has no double-dotted notes" },
  "triplet":      { "gp5": { "keys": ["numdiv"] }, "tf": { "keys": ["slash"] }, "fidelity": "equivalent" },
  "tie":          { "gp5": { "keys": ["l"] }, "tf": { "keys": ["l"] }, "fidelity": "exact" },
  "rest":         { "gp5": { "keys": ["r"] }, "tf": { "keys": ["r"] }, "fidelity": "exact" },
  "palm_mute":    { "gp5": { "keys": ["p"] }, "tf": { "keys": ["p"] }, "fidelity": "exact" },
  "let_ring":     { "gp5": { "keys": ["i"] }, "tf": { "keys": ["i"] }, "fidelity": "exact" },
  "vibrato":      { "gp5": { "keys": ["v"] }, "tf": { "keys": ["v"] }, "fidelity": "exact" },
  "slide":        { "gp5": { "keys": ["s"] }, "tf": { "keys": ["s"] }, "fidelity": "exact" },
  "hammer":       { "gp5": { "keys": ["h"] }, "tf": { "keys": ["h"] }, "fidelity": "exact" },
  "bend":         { "gp5": { "keys": ["b"], "dialog": "ok" }, "tf": { "keys": ["b"], "dialog": "ok" }, "fidelity": "approximate", "note": "both open a bend dialog; the default curve is accepted, so the curve itself may differ" },
  "ghost":        { "gp5": { "keys": ["o"] }, "tf": { "keys": ["o"] }, "fidelity": "exact" },
  "dead":         { "gp5": { "keys": ["x"] }, "tf": { "keys": ["x"] }, "fidelity": "exact" },
  "grace":        { "gp5": { "keys": ["g"], "dialog": "ok" }, "tf": { "keys": ["g"], "dialog": "ok" }, "fidelity": "approximate", "note": "both open a grace dialog; defaults accepted" },
  "accent":       { "gp5": { "menu": [5, 3] }, "tf": { "keys": ["oem1"] }, "fidelity": "equivalent", "note": "GP5: Effects > Accentuated Note (no default key)" },
  "heavy_accent": { "gp5": { "menu": [5, 4] }, "tf": { "cmd": "Tool.effect:heavy_accent" }, "fidelity": "equivalent", "note": "menu / palette only in both" },
  "harmonic":     { "gp5": { "menu": [5, 6] }, "tf": { "keys": ["y"], "dialog": "ok" }, "fidelity": "approximate", "note": "GP5 toggles a natural harmonic; TabForge opens the harmonic editor (default accepted)" },
  "staccato":     { "gp5": { "menu": [5, 17] }, "tf": { "keys": ["shift+1"] }, "fidelity": "equivalent", "note": "GP5: Effects > Staccato (no default key)" },
  "copy":         { "gp5": { "keys": ["ctrl+c"], "dialog": "ok" }, "tf": { "keys": ["ctrl+c"], "dialog": "ok" }, "fidelity": "exact", "note": "GP5 asks for the bar range when nothing is selected" },
  "cut":          { "gp5": { "keys": ["ctrl+x"], "dialog": "ok" }, "tf": { "keys": ["ctrl+x"], "dialog": "ok" }, "fidelity": "exact" },
  "paste":        { "gp5": { "keys": ["ctrl+v"], "dialog": "ok" }, "tf": { "keys": ["ctrl+v"], "dialog": "ok" }, "fidelity": "exact", "note": "GP5 asks how to paste bars (default: replace at the selection)" },
  "undo":         { "gp5": { "keys": ["ctrl+z"] }, "tf": { "keys": ["ctrl+z"] }, "fidelity": "exact" },
  "redo":         { "gp5": { "keys": ["ctrl+shift+z"] }, "tf": { "keys": ["ctrl+y"] }, "fidelity": "equivalent" },
  "sel_right":    { "gp5": { "keys": ["shift+right"] }, "tf": { "keys": ["shift+right"] }, "fidelity": "exact" },
  "sel_left":     { "gp5": { "keys": ["shift+left"] }, "tf": { "keys": ["shift+left"] }, "fidelity": "exact" },
  "select_all":   { "gp5": { "keys": ["ctrl+a"] }, "tf": { "keys": ["ctrl+a"] }, "fidelity": "exact" },
  "insert_bar":   { "gp5": { "keys": ["ctrl+ins"] }, "tf": { "keys": ["ctrl+ins"] }, "fidelity": "exact" },
  "delete_bar":   { "gp5": null, "tf": { "keys": ["ctrl+del"] }, "fidelity": "missing", "note": "GP5 5.2 has no delete-bar command (bars are removed by cutting a whole-bar selection)" },
  "semitone_up":  { "gp5": { "menu": [4, 18] }, "tf": { "keys": ["shift+up"] }, "fidelity": "equivalent", "note": "GP5 Note > Up one Semitone" },
  "semitone_down":{ "gp5": { "menu": [4, 19] }, "tf": { "keys": ["shift+down"] }, "fidelity": "equivalent" },
  "note_string_up":   { "gp5": { "keys": ["alt+up"] }, "tf": { "keys": ["alt+up"] }, "fidelity": "exact" },
  "note_string_down": { "gp5": { "keys": ["alt+down"] }, "tf": { "keys": ["alt+down"] }, "fidelity": "exact" },
  "tie_beat":     { "gp5": { "keys": ["ctrl+l"] }, "tf": { "cmd": "Tool.gp:tie_beat" }, "fidelity": "equivalent" },
  "key_c":        { "gp5": { "keys": ["c"] }, "tf": { "keys": ["c"] }, "fidelity": "approximate", "note": "same key, different command: GP5 copies the beat to the end of the bar, TabForge repeats the previous beat" },
  "time_sig_34":  { "gp5": { "menu": [2, 5], "dialog": "timesig:3/4" }, "tf": { "keys": ["ctrl+shift+t"], "dialog": "timesig:3/4" }, "fidelity": "approximate", "note": "dialog filled with 3/4 from the cursor bar" }
}
