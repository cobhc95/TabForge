<Project>
  <!-- Build settings shared by every TabForge project (app, audio engine, contracts), so they cannot drift. -->
  <PropertyGroup>
    <!-- Release version: the one place it is set. Shown in About/Settings, stamped into every assembly and the installer. -->
    <Version>0.5.1</Version>
    <!-- true marks a pre-release build even without a version suffix (About/Settings text, update check). 0.5 is the official release. -->
    <PreRelease>false</PreRelease>
    <Nullable>enable</Nullable>
    <!-- Hygiene: a warning is a build failure, so the tree stays at zero warnings. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Reproducible, machine-neutral binaries: source and PDB paths are recorded relative to the repository root. -->
    <!-- The version string carries no git commit id, so a build of the same source is byte-identical whichever
         repository clone (and commit id) it was built from. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- No source-control link in the PDB either (it records the commit and remote), so private and public clones of
         the same source build byte-identical binaries. -->
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=/_/</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="PreRelease" Value="$(PreRelease)" />
  </ItemGroup>
</Project>
